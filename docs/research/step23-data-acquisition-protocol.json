  "credentialPolicy": "no credential is entered or stored by this session; products requiring login are recorded as blocked with the required credential named; existence of credential files is checked without reading them",
  "sources": {
    "DATA-01": {
      "priority": [
        {
          "rank": 1,
          "product": "GLORYS12V1 GLOBAL_MULTIYEAR_PHY_001_030 (1/12 deg, daily, multi-depth uo/vo)",
          "provider": "Copernicus Marine",
          "access": "copernicusmarine toolbox + credentials",
          "status_if_no_credential": "DATASET_BLOCKED (credentials); STEP 17 BLOCKED/PENDING preserved"
        },
        {
          "rank": 2,
          "product": "any anonymous eddy-resolving (< 0.08 deg) reanalysis covering 2010 and 2015",
          "provider": "none identified",
          "access": "n/a",
          "status": "candidate list only; none known"
        }
      ],
      "depthInventoryRule": "record available depth levels only; no depth is selected; 15 m is not replaced",
      "download": "only if credentials/toolbox are present (they are not expected)"
    },
    "DATA-03": {
      "priority": [
        {
          "rank": 1,
          "product": "AVISO delayed-time absolute geostrophic currents, 0.25 deg, ~weekly (erdTAgeo1day; u_current/v_current at altitude 0), 1992-10-14..2012-12-08",
          "provider": "NOAA CoastWatch West Coast Node ERDDAP (coastwatch.pfeg.noaa.gov), anonymous",
          "role": "geostrophic surface current REFERENCE (not equal to drifter velocity)",
          "expectedCoverage": "2010 windows only; 2015 windows outside the product period"
        },
        {
          "rank": 2,
          "product": "AVISO absolute sea surface height + deviation, 0.25 deg, ~weekly (erdTAssh1day; ssh/sshd), 1992-10-14..2012-12-09",
          "provider": "same ERDDAP, anonymous",
          "role": "SSH / SSH-anomaly REFERENCE",
          "expectedCoverage": "2010 windows only"
        },
        {
          "rank": 3,
          "product": "OSCAR 1/3 deg 5-day surface velocity (jplOscar)",
          "provider": "same ERDDAP, anonymous",
          "role": "surface current reference",
          "expectedCoverage": "server holds 2011-12-06..2014-09-26 only: no window covered; metadata check only, no download"
        },
        {
          "rank": 4,
          "product": "NOAA NESDIS SSHA + geostrophic currents (nesdisSSH1day)",
          "provider": "same ERDDAP",
          "expectedCoverage": "2017+ only: no window covered; metadata check only"
        },
        {
          "rank": 5,
          "product": "OSCAR full period (PO.DAAC) / CMEMS SEALEVEL_GLO",
          "access": "Earthdata / Copernicus credentials",
          "status": "candidate only; not acquired"
        }
      ],
      "subset": "per window: box = ocean box +/- 3.0 deg (lon converted to the product convention), time = t0 - 8 d .. t0 + 72 h + 8 d (bracketing frames on both sides; no extrapolation)",
      "format": "ERDDAP griddap NetCDF",
      "queryRecorded": true
    },
    "DATA-06": {
      "priority": [
        {
          "rank": 1,
          "product": "IFREMER WAVEWATCH III global hindcast, CFSR-forced, GLOB-30M (0.5 deg), 3-hourly, surface Stokes drift 'uss' monthly files (WW3-GLOB-30M_YYYYMM_uss.nc)",
          "provider": "IFREMER (ftp.ifremer.fr/ifremer/ww3/HINDCAST/GLOBAL/<year>_CFSR/uss/), anonymous FTP",
          "role": "Stokes drift (surface) for a future TEST-06; not added to the model here",
          "granularity": "provider offers global monthly files only (~75 MB each); no spatial subsetting available on this endpoint — recorded as the reason for downloading whole files"
        },
        {
          "rank": 2,
          "product": "ERA5 Stokes drift (ust/vst) / CMEMS GLOBAL_MULTIYEAR_WAV_001_032 (VSDX/VSDY)",
          "access": "CDS / Copernicus credentials",
          "status": "candidate only; not acquired"
        }
      ],
      "files": [
        "WW3-GLOB-30M_201005_uss.nc",
        "WW3-GLOB-30M_201006_uss.nc",
        "WW3-GLOB-30M_201007_uss.nc",
        "WW3-GLOB-30M_201008_uss.nc",
        "WW3-GLOB-30M_201011_uss.nc",
        "WW3-GLOB-30M_201504_uss.nc"
      ],
      "expectedVariables": [
        "uuss",
        "vuss"
      ],
      "expectedUnits": "m s-1",
      "expectedCadenceSeconds": 10800
    }
  },
  "gates": {
    "G1": "provenance: provider, product, version, query/URL, retrieval time, license recorded",
    "G2": "file integrity: SHA-256 and byte size recorded; file readable",
    "G3": "coordinate validity: monotonic regular lat/lon, documented convention, within [-90,90]/[-180,360]",
    "G4": "time-axis validity: strictly increasing, calendar/units decoded, cadence recorded; irregular cadence allowed only if documented (weekly AVISO)",
    "G5": "variable availability: required variables present with standard/long names",
    "G6": "spatial coverage: every window ocean box inside the grid extent",
    "G7": "temporal coverage: frames bracket t0 and t0+72h for every window (no extrapolation)",
    "G8": "missingness: fraction of missing values in each window box at the bracketing frames recorded; release points must not be missing",
    "G9": "unit validity: velocity in m s-1 (or documented equivalent), SSH in m",
    "G10": "release-window coverage: for every drifter release point the nearest 4-node stencil is non-missing at both bracketing frames",
    "G11": "reproducibility: quality analysis re-run to a separate directory is byte-identical"
  },
  "gateRule": "any FAIL → DATASET_BLOCKED for that dataset; other datasets continue; windows failing G7/G10 mark the dataset PARTIAL_COVERAGE if at least one window passes",
  "finalStatuses": [
    "ACCEPTED_FOR_FUTURE_TEST",
    "DATASET_BLOCKED",
    "PARTIAL_COVERAGE",
    "LICENSE_STATUS_UNKNOWN",
    "INSUFFICIENT_EVIDENCE"
  ],
  "acceptedMeaning": "quality sufficient for a preregistered future sensitivity/comparison test; NOT approval for model use",
  "prohibited": {
    "missingFrameInterpolation": false,
    "gapFilling": false,
    "spatialExtrapolation": false,
    "zeroFill": false,
    "nearestFrameSubstitution": false,
    "landValueSubstitution": false,
    "smoothing": false,
    "duplicateFrames": false,
    "trajectoryIntegration": false,
    "alphaComparison": false,
    "metrics_M1_M5": false,
    "bestDatasetSelection": false,
    "step20Revision": false
  },
  "comparabilityFields": [
    "same geographic domain",
    "same time standard",
    "same observation windows",
    "same variable semantics",
    "compatible units",
    "compatible coordinate system",
    "compatible surface/depth interpretation"
  ],
  "outputs": [
    "docs/research/step23-data-acquisition-manifest.json",
    "docs/research/step23-data-quality-gates.json",
    "docs/research/step23-data-coverage-matrix.csv",
    "docs/research/step23-data-requirement-status.json",
    "docs/research/step23-acquisition/acquisition-log.jsonl"
  ],
  "dataRoot": "data/research/step23/ (gitignored; raw files never committed)",
  "tools": {
    "acquisition": "tools/research/acquire_step23.py",
    "quality": "tools/research/quality_step23.py",
    "validator": "tools/research/check_step23_data_quality.py"
  },
  "stopRule": "STOP after STEP 23; no model run; no alpha change; STEP 24 not started"
