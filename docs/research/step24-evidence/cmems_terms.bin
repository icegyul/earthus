ink is a phone number)","extUseFontAwesome":false,"extIconPlacement":"append","extPreventOrphan":false,"extFaLinkClasses":"fa fa-external-link","extFaMailtoClasses":"fa fa-envelope-o","extAdditionalLinkClasses":"","extAdditionalMailtoClasses":"","extAdditionalTelClasses":"","extFaTelClasses":"fa fa-phone","whitelistedDomains":[],"extExcludeNoreferrer":""}},"intercom":{"app_id":"cxqkdnoc","language_override":"en"},"ckeditorAccordion":{"accordionStyle":{"collapseAll":1,"keepRowsOpen":0,"animateAccordionOpenAndClose":1,"openTabsWithHash":0,"allowHtmlInTitles":0}},"toc":{"use_toc":false,"identifier":".node-page-field-content"},"cookies":{"cookiesjsr":{"config":{"cookie":{"name":"cookiesjsr","expires":31536000000,"domain":"","sameSite":"Lax","secure":false},"library":{"libBasePath":"https:\/\/cdn.jsdelivr.net\/gh\/jfeltkamp\/cookiesjsr@1\/dist","libPath":"https:\/\/cdn.jsdelivr.net\/gh\/jfeltkamp\/cookiesjsr@1\/dist\/cookiesjsr.min.js","scrollLimit":200},"callback":{"method":"post","url":"\/cookies\/consent\/callback.json","headers":[]},"interface":{"openSettingsHash":"#editCookieSettings","showDenyAll":true,"denyAllOnLayerClose":false,"settingsAsLink":false,"availableLangs":["en","bg","cs","da","de","et","el","es","fr","hr","it","lv","lt","hu","mt","nl","pl","pt-pt","ro","sk","sl","fi","sv"],"defaultLang":"en","groupConsent":false,"cookieDocs":true}},"services":{"performance":{"id":"performance","services":[{"key":"friendlycaptcha","type":"performance","name":"Friendly Captcha","info":{"value":"\u003Cp\u003EWeb forms are protected against spam and abuse using FriendlyCaptcha, a privacy-friendly verification solution that does not use cookies to track users\u0027 behavior across websites. FriendlyCaptcha works by generating cryptographic puzzles that are solved on the user\u0027s device, without collecting personal data or sending it to third parties for analysis.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/friendlycaptcha.com\/privacy","needConsent":true},{"key":"matomo","type":"performance","name":"Matomo Analytics","info":{"value":"\u003Cp\u003EWe analyse the traffic on this website and the behaviour of users to verify whether it fulfils its purpose and to improve it.\u0026nbsp;For this purpose, we use the open source analytics platform Matomo, hosted at\u0026nbsp;\u003Ca href=\u0022https:\/\/matomo.mercator-ocean.fr\u0022 target=\u0022_blank\u0022\u003Ehttps:\/\/matomo.mercator-ocean.fr\u003C\/a\u003E,\u0026nbsp;which is configured to not collect any information that could identify individual persons.\u003C\/p\u003E\r\n\r\n\u003Cp\u003EMatomo uses optional 1st party cookies to improve the accuracy of web statistics.\u0026nbsp;Find out detailed information \u003Ca href=\u0022https:\/\/matomo.org\/faq\/general\/faq_146\/\u0022 target=\u0022_blank\u0022\u003Ehere\u003C\/a\u003E.\u003C\/p\u003E\r\n\r\n\u003Ctable\u003E\r\n\u003Cthead\u003E\r\n\u003Ctr\u003E\r\n\t\u003Cth width=\u002215%\u0022\u003ECookie name\u003C\/th\u003E\r\n\t\u003Cth width=\u002215%\u0022\u003EDefault expiration time\u003C\/th\u003E\r\n\t\u003Cth\u003EDescription\u003C\/th\u003E\r\n\u003C\/tr\u003E\r\n\u003C\/thead\u003E\r\n\u003Ctbody\u003E\r\n\u003Ctr\u003E\r\n\t\u003Ctd\u003E\u003Ccode dir=\u0022ltr\u0022 translate=\u0022no\u0022\u003E_pk_id*\u003C\/code\u003E\u003C\/td\u003E\r\n\t\u003Ctd\u003E13 months\u003C\/td\u003E\r\n\t\u003Ctd\u003EUsed to store a few details about the user such as the unique visitor ID, to identify returning visitors.\u003C\/td\u003E\r\n\u003C\/tr\u003E\r\n\u003Ctr\u003E\r\n\t\u003Ctd\u003E\u003Ccode dir=\u0022ltr\u0022 translate=\u0022no\u0022\u003E_pk_ses*\u003C\/code\u003E\u003C\/td\u003E\r\n\t\u003Ctd\u003E30 minutes\u003C\/td\u003E\r\n\t\u003Ctd\u003E\r\n\t\u003Cp\u003EShort lived cookies used to temporarily store data for the visit.\u003C\/p\u003E\r\n\t\u003C\/td\u003E\r\n\u003C\/tr\u003E\r\n\u003Ctr\u003E\r\n\t\u003Ctd\u003E\u003Ccode dir=\u0022ltr\u0022 translate=\u0022no\u0022\u003E_pk_ref*\u003C\/code\u003E\u003C\/td\u003E\r\n\t\u003Ctd\u003E6 months\u003C\/td\u003E\r\n\t\u003Ctd\u003EUsed to store the\u0026nbsp;\u003Ca href=\u0022https:\/\/matomo.org\/faq\/general\/faq_106\/\u0022 target=\u0022_blank\u0022\u003Eattribution\u003C\/a\u003E\u0026nbsp;information, the referrer initially used to visit the website\u003C\/td\u003E\r\n\u003C\/tr\u003E\r\n\u003C\/tbody\u003E\r\n\u003C\/table\u003E\r\n\r\n\u003Cp\u003EPlease note that refusing Matomo cookies will not prevent us from gathering web statistics. To completely opt-out of being included in our aggregated statistics, use the checkbox below.\u003C\/p\u003E\r\n\r\n\u003Cp\u003E\u003Ciframe src=\u0022https:\/\/matomo.mercator-ocean.fr\/index.php?module=CoreAdminHome\u0026amp;action=optOut\u0026amp;language=en\u0026amp;fontFamily=Lato\u0022 style=\u0022border: 0\u0022 width=\u0022100%\u0022\u003E\u003C\/iframe\u003E\u003C\/p\u003E\r\n","format":"full_html"},"uri":"https:\/\/marine.copernicus.eu\/privacy-policy","needConsent":true}],"weight":30},"functional":{"id":"functional","services":[{"key":"functional","type":"functional","name":"Required functional","info":{"value":"\u003Ctable\u003E\r\n\u003Cthead\u003E\r\n\u003Ctr\u003E\r\n\t\u003Cth width=\u002215%\u0022\u003ECookie name\u003C\/th\u003E\r\n\t\u003Cth width=\u002215%\u0022\u003EDefault expiration time\u003C\/th\u003E\r\n\t\u003Cth\u003EDescription\u003C\/th\u003E\r\n\u003C\/tr\u003E\r\n\u003C\/thead\u003E\r\n\u003Ctbody\u003E\r\n\u003Ctr\u003E\r\n\t\u003Ctd\u003E\u003Ccode dir=\u0022ltr\u0022 translate=\u0022no\u0022\u003ESSESS\u0026lt;ID\u0026gt;\u003C\/code\u003E\u003C\/td\u003E\r\n\t\u003Ctd\u003E1 month\u003C\/td\u003E\r\n\t\u003Ctd\u003EIf you are logged in to this website, a session cookie is required to identify and connect your browser to your user account in the server backend of this website.\u003C\/td\u003E\r\n\u003C\/tr\u003E\r\n\u003Ctr\u003E\r\n\t\u003Ctd\u003E\u003Ccode dir=\u0022ltr\u0022 translate=\u0022no\u0022\u003Ecookiesjsr\u003C\/code\u003E\u003C\/td\u003E\r\n\t\u003Ctd\u003E1 year\u003C\/td\u003E\r\n\t\u003Ctd\u003EWhen you visited this website for the first time, you were asked for your permission to use several services (including those from third parties) that require data to be saved in your browser (cookies, local storage). Your decisions about each service (allow, deny) are stored in this cookie and are reused each time you visit this website. Click \u003Ca href=\u0022#editCookieSettings\u0022\u003Ehere \u003C\/a\u003Eto revise your preferences.\u003C\/td\u003E\r\n\u003C\/tr\u003E\r\n\u003C\/tbody\u003E\r\n\u003C\/table\u003E\r\n","format":"full_html"},"uri":"","needConsent":false},{"key":"google","type":"functional","name":"Google Maps","info":{"value":"Our website may include pages which embed interactive \u003Ca href=\u0022https:\/\/www.google.com\/maps\u0022 target=\u0022_blank\u0022\u003EGoogle Maps\u003C\/a\u003E. In order to view those maps you must accept the 3rd party cookies set by Google.","format":"full_html"},"uri":"https:\/\/policies.google.com\/technologies\/cookies?hl=en-US","needConsent":true},{"key":"intercom","type":"functional","name":"Intercom","info":{"value":"\u003Cp\u003EThe\u0026nbsp;\u003Ca href=\u0022https:\/\/www.intercom.com\/\u0022 target=\u0022_blank\u0022\u003EIntercom \u003C\/a\u003Emessaging platform is essential for us to allow visitors get in touch with our support team and share their feedback.\u0026nbsp;\u003C\/p\u003E\r\n\r\n\u003Cp\u003EIntercom uses 3st party cookies, as described in the table below.\u003C\/p\u003E\r\n\r\n\u003Ctable\u003E\r\n\u003Cthead\u003E\r\n\u003Ctr\u003E\r\n\t\u003Cth width=\u002215%\u0022\u003ECookie name\u003C\/th\u003E\r\n\t\u003Cth width=\u002215%\u0022\u003EDefault expiration time\u003C\/th\u003E\r\n\t\u003Cth\u003EDescription\u003C\/th\u003E\r\n\u003C\/tr\u003E\r\n\u003C\/thead\u003E\r\n\u003Ctbody\u003E\r\n\u003Ctr\u003E\r\n\t\u003Ctd\u003E\u003Ccode dir=\u0022ltr\u0022 translate=\u0022no\u0022\u003Eintercom-id-*\u003C\/code\u003E\u003C\/td\u003E\r\n\t\u003Ctd\u003E9 months\u003C\/td\u003E\r\n\t\u003Ctd\u003EUnique anonymous identifier which allows identification of past conversations with visitors of our website.\u003C\/td\u003E\r\n\u003C\/tr\u003E\r\n\u003Ctr\u003E\r\n\t\u003Ctd\u003E\u003Ccode dir=\u0022ltr\u0022 translate=\u0022no\u0022\u003Eintercom-session-*\u003C\/code\u003E\u003C\/td\u003E\r\n\t\u003Ctd\u003E7 days\u003C\/td\u003E\r\n\t\u003Ctd\u003E\r\n\t\u003Cp\u003EAllows users to access their conversations and have data communicated on logged out pages for 1 week.\u003C\/p\u003E\r\n\t\u003C\/td\u003E\r\n\u003C\/tr\u003E\r\n\u003C\/tbody\u003E\r\n\u003C\/table\u003E\r\n\r\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\r\n","format":"full_html"},"uri":"https:\/\/www.intercom.com\/legal\/cookie-policy","needConsent":false},{"key":"issuu","type":"functional","name":"ISSUU","info":{"value":"\u003Cp\u003EOur flagship publications and reports are stored on \u003Ca href=\u0022https:\/\/issuu.com\/\u0022 target=\u0022_blank\u0022\u003EISSUU\u003C\/a\u003E, a digital publishing platform.\u0026nbsp;For interacting with those publications embedded in the website, you must accept the 3rd party cookies set by ISSUU.\u003C\/p\u003E\r\n","format":"full_html"},"uri":"https:\/\/issuu.com\/legal\/cookies","needConsent":true},{"key":"prezi","type":"functional","name":"Prezi","info":{"value":"\u003Cp\u003EOur website may include pages which embed multimedia content stored on \u003Ca href=\u0022https:\/\/prezi.com\u0022 target=\u0022_blank\u0022\u003EPrezi\u003C\/a\u003E, a multimedia presentation platform. For interacting with those videos or presentations you must accept the 3rd party cookies set by Prezi.\u003C\/p\u003E\r\n","format":"full_html"},"uri":"https:\/\/prezi.com\/cookie-policy\/","needConsent":true},{"key":"twitter","type":"functional","name":"X","info":{"value":"\u003Cp\u003EOur website may include pages with content \u003Ca href=\u0022https:\/\/x.com\/CMEMS_EU\u0022 target=\u0022_blank\u0022\u003Epublished on X\u003C\/a\u003E.\u0026nbsp;By accepting 3rd party cookies from X, formerly known as Twitter, you will get an improved user experience in the form of the embedded X feed.\u003C\/p\u003E\u003Cp\u003EX may receive information including the web page you visited, your IP address, browser type, operating system, and cookie information.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/help.x.com\/en\/rules-and-policies\/x-cookies","needConsent":true},{"key":"video","type":"functional","name":"YouTube","info":{"value":"\u003Cp\u003EOur website may include pages which embed multimedia content stored on\u0026nbsp;\u003Ca href=\u0022https:\/\/youtube.com\u0022 target=\u0022_blank\u0022\u003EYouTube\u003C\/a\u003E. For interacting with those videos you must accept the 3rd party cookies set by YouTube.\u003C\/p\u003E\r\n","format":"full_html"},"uri":"https:\/\/policies.google.com\/technologies\/cookies","needConsent":true},{"key":"videopress","type":"functional","name":"Videopress","info":{"value":"\u003Cp\u003EOur website may include pages which embed multimedia content stored on \u003Ca href=\u0022https:\/\/videopress.com\u0022 target=\u0022_blank\u0022\u003EVideopress\u003C\/a\u003E, a multimedia presentation platform. For interacting with those videos or presentations you must accept the 3rd party cookies set by Videopress.\u003C\/p\u003E\r\n\r\n\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E\r\n","format":"full_html"},"uri":"https:\/\/automattic.com\/cookies\/","needConsent":true}],"weight":50},"ads":{"id":"ads","services":[{"key":"bing_ads","type":"ads","name":"Bing Ads","info":{"value":"\u003Cp\u003EOur website may include pages that feature Bing Ads, displaying advertisements and promotional content specific to your browsing habits. To engage with these ads, you must accept the 3rd party cookies set by Bing. These cookies help track user behavior to provide relevant and personalized advertising experiences.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/privacy.microsoft.com\/en-us\/privacystatement","needConsent":true},{"key":"facebook_ads","type":"ads","name":"Facebook Ads","info":{"value":"\u003Cp\u003EOur website may feature content that includes Facebook Ads, which provide tailored advertisements and promotional content. To see and interact with these ads, you need to accept the 3rd party cookies set by Facebook. These cookies help track user activity and preferences to ensure ads are relevant and personalized.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/www.facebook.com\/privacy\/policies\/cookies\/","needConsent":true},{"key":"google_ads","type":"ads","name":"Google Ads","info":{"value":"\u003Cp\u003EOur website may use Google Ads to show advertisements and promotional content tailored to your interests. Accepting the 3rd party cookies set by Google is necessary to interact with these ads. These cookies collect data on user interactions and browsing history to deliver targeted and personalized advertising.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/policies.google.com\/technologies\/cookies","needConsent":true},{"key":"instagram_ads","type":"ads","name":"Instagram Ads","info":{"value":"\u003Cp\u003EOur website may display Instagram Ads within certain pages, offering customized advertisements and promotions. For these ads to function properly and provide relevant content, you must accept the 3rd party cookies set by Instagram, which are used to monitor user engagement and deliver targeted advertising.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/privacycenter.instagram.com\/policies\/cookies\/","needConsent":true},{"key":"linkedin_ads","type":"ads","name":"LinkedIn Ads","info":{"value":"\u003Cp\u003EOur website may contain LinkedIn Ads, presenting advertisements and promotional material suited to your professional interests. Interaction with these ads requires accepting 3rd party cookies set by LinkedIn, which track user behavior and preferences to serve more relevant advertising content.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/linkedin.com\/legal\/cookie-policy","needConsent":true},{"key":"twitter_ads","type":"ads","name":"Twitter Ads","info":{"value":"\u003Cp\u003EOur website may include pages that integrate Twitter Ads to display promotional content and advertisements relevant to your interests. These ads use 3rd party cookies set by Twitter to track user interactions and deliver targeted advertising based on your browsing behavior.\u003C\/p\u003E","format":"full_html"},"uri":"https:\/\/x.com\/en\/privacy","needConsent":true}],"weight":70}},"translation":{"_core":{"default_config_hash":"C8aQz-3d6YpwuU4QQc1iaWHb3RDkc_C9qcEsgR7HR74"},"langcode":"en","bannerText":"We and our third-party partners use cookies to operate our site, improve the user experience and site performance, propose advertising tailored to your interests and enable social media sharing.\r\nIf you choose \u0022ACCEPT ALL\u0022, you consent to the use of all cookies. If you choose \u201cREFUSE ALL\u201d, your use of the site can be interrupted or you may experience problems accessing the site.\r\n","privacyPolicy":"Privacy policy","privacyUri":"\/privacy-policy","imprint":"","imprintUri":"","cookieDocs":"Cookies policy","cookieDocsUri":"\/cookies\/documentation","officialWebsite":"Official website","denyAll":"Refuse all","alwaysActive":"Always active","settings":"Choose","acceptAll":"Accept all","requiredCookies":"Required cookies","cookieSettings":"Cookie settings","close":"Close","readMore":"Read more","allowed":"allowed","denied":"denied","settingsAllServices":"Settings for all services","saveSettings":"Save","default_langcode":"en","disclaimerText":"All cookie information is subject to change by the service providers. We update this information regularly.","disclaimerTextPosition":"above","processorDetailsLabel":"Processor Company Details","processorLabel":"Company","processorWebsiteUrlLabel":"Company Website","processorPrivacyPolicyUrlLabel"