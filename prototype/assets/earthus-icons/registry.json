  "hard_rules": [
    "Do not use emoji, Font Awesome, Lucide, Material Icons, or ad-hoc SVG glyphs for primary EARTHUS data menus.",
    "Use the registry asset for every matching label in V1 and V2.",
    "Keep the same icon ID across V1 and V2.",
    "Intelligence is not a primary navigation item; it is attached to the selected primary data context.",
    "Simulation is not a primary navigation item; it follows Intelligence and is entitlement-gated for Pro+.",
    "Primary data icon = first-order observable Earth phenomenon. Secondary sublayer inherits the parent icon unless an approved dedicated icon exists."
  ],
  "notes": [
