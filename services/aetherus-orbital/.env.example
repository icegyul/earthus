# AETHERUS Orbital — 로컬 설정 예시
#
# 사용법: 이 파일을 같은 폴더에 `.env` 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# `.env` 는 .gitignore로 제외돼 있어 커밋되지 않는다 (이 예시 파일만 추적된다).
# 비밀값은 코드에서 SecretStr로 읽혀 로그·에러·API 응답에 노출되지 않는다.

# --- Space-Track (선택) ---------------------------------------------------
# 가입: https://www.space-track.org/auth/createAccount  (무료)
# 없으면 시스템은 CelesTrak 공개 GP만 쓰고 Space-Track 경로는 정직하게
# UNAVAILABLE 을 반환한다 — 값을 지어내지 않는다.
# 채운 뒤 API 서버를 재시작해야 반영된다.
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# --- 인프라 (기본값으로 충분; docker compose 와 일치) -----------------------
# DATABASE_URL=postgresql+asyncpg://aetherus:aetherus_dev_password@localhost:5432/aetherus
# REDIS_URL=redis://localhost:6379/0

# --- 저장 경로 -------------------------------------------------------------
# RAW_ARTIFACT_DIR=artifacts/raw
