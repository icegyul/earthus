{
  "title": "ConfidenceAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target_type",
    "target_id",
    "grade",
    "factors",
    "computed_at",
    "policy_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "target_type": {
      "enum": [
        "SIGNAL",
        "EVENT",
        "REVISION",
        "SCENARIO",
        "ATTRIBUTION"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "grade": {
      "enum": [
        "VERY_LOW",
        "LOW",
        "MEDIUM",
        "HIGH",
        "VERY_HIGH",
        "NOT_ASSESSED"
      ]
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "weight",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherus.dev/schemas/ConfidenceAssessment.schema.json"
}