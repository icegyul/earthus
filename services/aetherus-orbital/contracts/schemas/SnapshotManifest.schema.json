{
  "$defs": {
    "CanonicalTimeContext": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/StateKind"
        },
        "cursor_utc": {
          "format": "date-time",
          "title": "Cursor Utc",
          "type": "string"
        },
        "resolved_from_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved From Timezone"
        },
        "source_time_scale": {
          "default": "UTC",
          "title": "Source Time Scale",
          "type": "string"
        },
        "archived_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archived Snapshot Id"
        },
        "reconstructed_from_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reconstructed From Snapshot Ids",
          "type": "array"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        }
      },
      "required": [
        "mode",
        "cursor_utc"
      ],
      "title": "CanonicalTimeContext",
      "type": "object"
    },
    "StateKind": {
      "enum": [
        "ARCHIVED_STATE",
        "RECONSTRUCTED_STATE",
        "NOW",
        "PREDICTED_MODEL",
        "SIMULATION",
        "COUNTERFACTUAL"
      ],
      "title": "StateKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "state_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "State Ids",
      "type": "array"
    },
    "time_context": {
      "$ref": "#/$defs/CanonicalTimeContext"
    },
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "baseline": {
      "default": false,
      "title": "Baseline",
      "type": "boolean"
    }
  },
  "required": [
    "snapshot_hash",
    "state_ids",
    "time_context",
    "created_at"
  ],
  "title": "SnapshotManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherus.dev/schemas/SnapshotManifest.schema.json"
}