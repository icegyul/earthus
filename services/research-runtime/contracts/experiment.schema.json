{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:earthus:research:experiment:1.0",
  "title": "EARTHUS surface passive advection experiment",
  "type": "object",
  "required": ["schemaVersion", "projectId", "question", "modelId", "modelVersion", "datasetVersions", "area", "startTimeUTC", "durationSeconds", "releaseDefinition", "particleCount", "integrationMethod", "integrationStepSeconds", "outputStepSeconds", "boundaryPolicy"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "modelId": {"const": "surface-passive-advection.v1"},
    "modelVersion": {"const": "0.1.0"},
    "datasetVersions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["datasetId", "version"], "properties": {"datasetId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}},
    "area": {"type": "object", "required": ["west", "east", "south", "north"], "additionalProperties": false, "properties": {"west": {"type": "number", "minimum": -180, "maximum": 180}, "east": {"type": "number", "minimum": -180, "maximum": 180}, "south": {"type": "number", "minimum": -80, "maximum": 80}, "north": {"type": "number", "minimum": -80, "maximum": 80}}},
    "startTimeUTC": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "durationSeconds": {"type": "integer", "minimum": 1, "maximum": 259200},
    "integrationStepSeconds": {"type": "integer", "minimum": 1},
    "outputStepSeconds": {"type": "integer", "minimum": 1},
    "particleCount": {"type": "integer", "minimum": 1, "maximum": 10000},
    "releaseDefinition": {"type": "object", "required": ["type", "points"], "properties": {"type": {"const": "points"}, "points": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "required": ["lon", "lat"], "properties": {"lon": {"type": "number", "minimum": -180, "maximum": 180}, "lat": {"type": "number", "minimum": -80, "maximum": 80}, "count": {"type": "integer", "minimum": 1, "maximum": 10000}}}}}},
    "integrationMethod": {"const": "RK4"},
    "boundaryPolicy": {"const": "STOP_AT_FIRST_CROSSING"},
    "backend": {"enum": ["oceanparcels", "analytic-reference"]},
    "metrics": {"type": "array", "items": {"type": "string"}}
  },
  "$comment": "Runtime preflight additionally validates area ordering, particle count sum, complete forcing coverage, dataset binding, wet release cells, native engine availability, step and output resource limits. analytic-reference is permitted only for SYNTHETIC_TEST."
}
