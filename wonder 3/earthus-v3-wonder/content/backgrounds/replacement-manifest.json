    { "id": "ice_01",            "class": "region",     "geo": { "lat": -75.0, "lon": 0.0 }, "reference_place": "남극 빙붕", "time": "낮(백야)", "brief_ko": "빙붕 절벽과 떠 있는 빙산 두세 개, 연한 하늘. 눈·얼음은 연한 회청색 종이. 아래 28% 는 눈 평면.", "must_include": ["빙붕", "빙산"], "status": "pending", "replaces": "6ccef70d305d", "provenance": null },
