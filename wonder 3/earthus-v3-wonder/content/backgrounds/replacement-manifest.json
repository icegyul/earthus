    { "id": "sky_island_01",     "class": "world",      "geo": null, "reference_place": "지구 전체 무대(특정 지역 아님)", "time": "낮", "brief_ko": "구름층 위에서 본 종이 하늘 무대. 층층이 겹친 종이 구름, 멀리 작은 종이 섬 두세 개가 떠 있음. 아래 28% 는 평평한 구름 바닥.", "must_include": ["층 구름", "떠 있는 종이 섬(작게, 원경)"], "status": "pending", "replaces": "1b04c03d2d15", "provenance": null },
    { "id": "korea_seoul_01",    "class": "korea",      "geo": { "lat": 37.57, "lon": 126.98 }, "reference_place": "서울 — 한강·남산", "time": "낮", "brief_ko": "한강과 다리 한 개, 뒤로 남산과 타워 실루엣, 종이 빌딩 몇 겹. 한지 질감. 아래 28% 는 강변 둔치 평면.", "must_include": ["한강 다리", "남산 타워 실루엣"], "status": "pending", "replaces": "ce657dd4bb3d", "provenance": null },
