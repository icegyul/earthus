    { "id": "korea_gyeongju_01", "class": "korea",      "geo": { "lat": 35.86, "lon": 129.22 }, "reference_place": "경주 — 대릉원·첨성대", "time": "낮", "brief_ko": "둥근 종이 고분 둔덕 여러 개, 왼쪽 원경에 첨성대, 소나무 몇 그루(안전영역 밖). 아래 28% 는 잔디 평면.", "must_include": ["고분 둔덕", "첨성대"], "status": "pending", "replaces": "df919b431094", "provenance": null },
    { "id": "korea_jeju_01",     "class": "korea",      "geo": { "lat": 33.50, "lon": 126.53 }, "reference_place": "제주 — 한라산·오름·돌담", "time": "늦은 오후", "brief_ko": "한라산 실루엣과 오름 두세 개, 앞쪽 현무암 돌담 한 줄(낮게), 유채꽃 색면. 아래 28% 는 밭 평면.", "must_include": ["한라산", "오름", "돌담(낮게)"], "status": "pending", "replaces": "81830df4c7a9", "provenance": null },
