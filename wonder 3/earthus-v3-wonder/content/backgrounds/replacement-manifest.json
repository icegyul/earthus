    { "id": "cave_01",           "class": "region",     "geo": null, "reference_place": "일반 동굴 내부", "time": "빛줄기", "brief_ko": "종이 종유석·석순 층, 위에서 내려오는 빛 한 줄기, 뒤로 어두운 동굴 벽. 아래 28% 는 평평한 바닥(빛 받는 곳).", "must_include": ["종유석", "빛줄기"], "status": "pending", "replaces": "29d0bfc62827", "provenance": null },
